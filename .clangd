CompileFlags:
    Add:
        - --driver-mode=cl
        - --target=x86_64-pc-windows-msvc
        - -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH

Index:
    Background: Skip

Diagnostics:
    Suppress:
        - "*"
        - fatal_too_many_errors
    IgnoreHeader:
      - minwindef\.h
      - windef\.h
      - winnt\.h
      - winuser\.h
      - wingdi\.h
      - processthreadsapi\.h
